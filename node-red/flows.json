  {
    "id": "tpl",
    "type": "ui_template",
    "z": "tab1",
    "group": "grpmap",
    "name": "Mapa de vagas",
    "order": 1,
    "width": "12",
    "height": "6",
    "format": "<style>\n.vaga{display:inline-block;width:92px;margin:4px;padding:10px 4px;border-radius:8px;color:#fff;text-align:center;font-weight:bold}\n.vaga.livre{background:#2e9e4f}.vaga.ocupada{background:#c62828}.vaga.reservada{background:#1565c0}\n</style>\n<div ng-if=\"msg.payload\">\n  <h2>Vagas livres: {{msg.payload.livres}} de {{msg.payload.total}}</h2>\n  <div ng-repeat=\"a in msg.payload.andares\">\n    <h3>{{a.nome}} - livres: {{a.livres}} | ocupadas: {{a.ocupadas}} | reservadas: {{a.reservadas}}</h3>\n    <span ng-repeat=\"v in a.vagas\" class=\"vaga\" ng-class=\"v.status\">{{v.vaga}}<br>{{v.status}}</span>\n  </div>\n</div>\n<div ng-if=\"!msg.payload\">Aguardando dados dos sensores...</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 650,
    "y": 120,
    "wires": [
      []
    ]
  },
