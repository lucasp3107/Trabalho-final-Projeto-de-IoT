  {
    "id": "fncmd",
    "type": "function",
    "z": "tab1",
    "name": "Montar comando (validado)",
    "func": "const ROOT = \"estac_fag_t04n\";\nconst permitidos = [\"reservar\", \"liberar\"];                       // lista branca\nif (permitidos.indexOf(msg.payload) < 0) return null;\nif (!/^andar[0-9]+\\/vaga[0-9]+$/.test(msg.topic)) return null;   // formato do alvo\nmsg.topic = ROOT + \"/\" + msg.topic + \"/cmd\";\nmsg.qos = 1;\nmsg.retain = false;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
