  {
    "id": "fnc",
    "type": "function",
    "z": "tab1",
    "name": "Consolidar por andar",
    "func": "const ROOT = \"estac_fag_t04n\";\n// topico esperado: ROOT/andarN/vagaNN/status\nconst m = msg.topic.split(\"/\");\nif (m.length !== 4 || m[0] !== ROOT || m[3] !== \"status\") return null;\nconst andar = m[1], vaga = m[2];\nconst p = msg.payload;\nconst validos = [\"livre\", \"ocupada\", \"reservada\"];\nif (!p || typeof p !== \"object\" || validos.indexOf(p.status) < 0) {\n    node.warn(\"Payload invalido descartado: \" + JSON.stringify(p));\n    return null;\n}\nlet vagas = flow.get(\"vagas\") || {};\nvagas[andar + \"/\" + vaga] = { andar: andar, vaga: vaga, status: p.status, dist: p.dist_cm, modo: p.modo };\nflow.set(\"vagas\", vagas);\n\nconst porAndar = {};\nlet livres = 0, total = 0;\nObject.keys(vagas).sort().forEach(k => {\n    const v = vagas[k];\n    if (!porAndar[v.andar]) porAndar[v.andar] = { nome: v.andar, livres: 0, ocupadas: 0, reservadas: 0, vagas: [] };\n    const a = porAndar[v.andar];\n    a.vagas.push(v);\n    if (v.status === \"livre\") { a.livres++; livres++; }\n    else if (v.status === \"ocupada\") a.ocupadas++;\n    else a.reservadas++;\n    total++;\n});\nconst painel = (flow.get(\"ultimoLivres\") !== livres)\n    ? { topic: ROOT + \"/painel/livres\", payload: String(livres), qos: 1, retain: true } : null;\nflow.set(\"ultimoLivres\", livres);\nreturn [painel, { payload: { andares: Object.values(porAndar), livres: livres, total: total } }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [
      [
        "mqpainel"
      ],
      [
        "tpl"
      ]
    ]
  },
  {
    "id": "mqpainel",
    "type": "mqtt out",
    "z": "tab1",
    "name": "painel/livres",
    "topic": "",
    "qos": "1",
    "retain": "",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker",
